{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InfraestructuraDelProyecto",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "ecr:*",
        "rds:*",
        "ssm:*",
        "elasticloadbalancing:*",
        "logs:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RolesDeEcsDelProyecto",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/laura-*"
    },
    {
      "Sid": "RolesVinculadosAServicios",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/*"
    },
    {
      "Sid": "EstadoDeTerraformEnS3",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::laura-tf-state-xyz89b",
        "arn:aws:s3:::laura-tf-state-xyz89b/*"
      ]
    },
    {
      "Sid": "CandadoDeTerraformEnDynamoDB",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:*:*:table/laura-tf-locks-xyz89b"
    }
  ]
}
