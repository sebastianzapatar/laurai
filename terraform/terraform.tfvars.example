###############################################################
# terraform.tfvars.example
# Copia este archivo como terraform.tfvars y completa los valores
# NUNCA subas terraform.tfvars al repositorio (ya está en .gitignore)
###############################################################

aws_region   = "us-east-2"
project_name = "laura"
environment  = "prod"

# Base de datos
db_name     = "chefs_db"
db_username = "postgres"
db_password = "CAMBIA_ESTO_POR_UNA_CONTRASEÑA_SEGURA"

# Keycloak - URI de tu instancia de Keycloak en producción
keycloak_issuer_uri = "https://tu-keycloak.dominio.com/realms/chefs-realm"

# ECS / Contenedor
container_port = 6969
task_cpu       = 512    # 0.5 vCPU
task_memory    = 1024   # 1 GB
desired_count  = 1
